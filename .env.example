# Resend (https://resend.com) — used by app/api/contact/route.ts to email quote requests
RESEND_API_KEY=
# Optional: sender identity. securikey.co.im is verified in Resend.
RESEND_FROM_EMAIL="Securikey Quotes <quotes@securikey.co.im>"
# Optional: where quote request emails are delivered to (comma-separated for multiple recipients)
RESEND_TO_EMAIL=lee@securikey.co.im,john@securikey.co.im
